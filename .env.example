# Environment Configuration
# Unset uses dev for local Uvicorn; Docker Compose defaults to prod.
# Set APP_ENV=dev explicitly when running Docker Compose for local development.

# Required signing secret for short-lived pre-authentication CSRF tokens.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Local application database; Docker Compose uses its PostgreSQL service.
DATABASE_URL=sqlite:///./app.db
# Generate a URL-safe password for the Docker Compose PostgreSQL service.
# python -c "import secrets; print(secrets.token_urlsafe(32))"
POSTGRES_PASSWORD=

# Set APP_ENV=dev explicitly when using HTTP locally with Docker Compose.
# Production Compose requires HTTPS origins and production trusted hosts.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_PRE_PING=true
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_CONNECT_TIMEOUT=10

# Cookie & Session Settings
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
ALLOWED_ORIGINS=["http://localhost:8000","http://127.0.0.1:8000"]
ALLOWED_HOSTS=["localhost","127.0.0.1"]
FORWARDED_ALLOW_IPS=127.0.0.1

# Machine Learning & AI
EMBED_MODEL=all-MiniLM-L6-v2
# Optional Anthropic API key for AI rewrites
# ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5-5

# Rate Limits
RATE_LIMIT_LOGIN=5/minute
RATE_LIMIT_REGISTER=3/minute
RATE_LIMIT_ANALYZE=10/minute
