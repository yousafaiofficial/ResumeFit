# Environment Configuration
APP_ENV=dev
DEBUG=true

# Required signing secret for short-lived pre-authentication CSRF tokens.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Local application database; Docker Compose uses its PostgreSQL service.
DATABASE_URL=sqlite:///./app.db
# Generate a URL-safe password for the Docker Compose PostgreSQL service.
# python -c "import secrets; print(secrets.token_urlsafe(32))"
POSTGRES_PASSWORD=
# DATABASE_URL=postgresql://user:password@localhost:5432/resumefit

# Redis (Optional in local dev, recommended in prod for rate limits & cache)
# REDIS_URL=redis://localhost:6379/0

# Cookie & Session Settings
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
ALLOWED_ORIGINS=["http://localhost:8000","http://127.0.0.1:8000"]
ALLOWED_HOSTS=["localhost","127.0.0.1"]

# Machine Learning & AI
EMBED_MODEL=all-MiniLM-L6-v2
# Optional Anthropic API key for AI rewrites
# ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5-5

# Rate Limits
RATE_LIMIT_LOGIN=5/minute
RATE_LIMIT_REGISTER=3/minute
RATE_LIMIT_ANALYZE=10/minute
