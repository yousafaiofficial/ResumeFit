# Environment Configuration
APP_ENV=dev
DEBUG=true

# Security & Secrets (In staging/production, must be >= 32 random characters)
SECRET_KEY=dev-insecure-secret-key-replace-in-production-must-be-32-chars
# Secondary key for zero-downtime key rotation
# PREVIOUS_SECRET_KEY=

# Database Connection (Neon / Supabase / RDS PostgreSQL in prod)
DATABASE_URL=sqlite:///./app.db
# DATABASE_URL=postgresql://user:password@localhost:5432/resumefit

# Redis (Optional in local dev, recommended in prod for rate limits & cache)
# REDIS_URL=redis://localhost:6379/0

# Cookie & Session Settings
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Machine Learning & AI
EMBED_MODEL=all-MiniLM-L6-v2
# Optional Anthropic API key for AI rewrites
# ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5-5

# Rate Limits
RATE_LIMIT_LOGIN=5/minute
RATE_LIMIT_REGISTER=3/minute
RATE_LIMIT_ANALYZE=10/minute
